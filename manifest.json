{
  "id": "leads",
  "version": "0.1.0",
  "description": "Personal RU/EN lead discovery: Reddit RSS/JSON/OAuth, optional X/Threads APIs, precise buyer rules, AI verdicts and Telegram + web notifications. Generic declarative views require Delta Web 0.6.0+.",
  "metadata": {
    "ui": {
